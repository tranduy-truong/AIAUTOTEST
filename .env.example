# --- CẤU HÌNH AI PROVIDER ---
# Cách 1: Sử dụng OpenRouter (Khuyên dùng cho nhiều model: Claude 3.5 Sonnet, DeepSeek R1, Gemini...)
# Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.0-flash-exp:free
# Các model OpenRouter phổ biến khác:
# AI_MODEL=deepseek/deepseek-r1:free
# AI_MODEL=deepseek/deepseek-chat:free
# AI_MODEL=anthropic/claude-3.5-sonnet
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# Cách 2: Sử dụng Google AI Studio (Gemini trực tiếp)
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# Cách 3: Sử dụng Groq (Llama 3.3 70B)
# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# Cách 4: Sử dụng Agnes AI (Sapiens AI)
# Lấy API key tại: https://platform.agnes-ai.com
# AGNES_API_KEY=
# AI_MODEL=agnes-2.0-flash
# Các model Agnes AI khác: agnes-2.5-flash, agnes-2.5-pro, agnes-2.5-pro-alpha
